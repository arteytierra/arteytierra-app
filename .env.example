# ===== Site =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ACEQUIA_APP_URL=https://app.acequia.app
NEXT_PUBLIC_ACEQUIA_APP_HOST=app.acequia.app
# Mantener false hasta aprobar legales, sandbox y la migración de prueba.
ACEQUIA_TRIAL_ENABLED=false

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Stripe (USD / internacional) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ===== Mercado Pago (ARS / LATAM) =====
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=

# ===== Email (Resend o Postmark — autoselecciona por env presente) =====
RESEND_API_KEY=
RESEND_FROM="Arte y Tierra <hola@arteytierra.org>"
# POSTMARK_TOKEN=
# POSTMARK_FROM="hola@arteytierra.org"
# Webhook signing (Postmark/Resend → /api/email/webhook)
EMAIL_WEBHOOK_SECRET=

# ===== n8n =====
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# ===== Meta / Analytics =====
META_PIXEL_ID=
META_CAPI_TOKEN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# ===== Video (Mux o Cloudflare Stream) =====
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=

# ===== Web Push (VAPID) =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@arteytierra.org

# ===== Cron (Cloudflare Workers / Vercel Cron) =====
CRON_SECRET=

# ===== i18n =====
# CSV con locales habilitados (además de 'es' que es default). Vacío = sólo ES.
ENABLE_LOCALES=

# ===== Observability =====
# Rate de muestreo de Core Web Vitals (0 — 1). Default 1 en dev, 0.1 producción recomendado.
RUM_SAMPLE_RATE=1

# ===== Feature flags =====
# Override manual de flags por env (formato JSON, opcional): {"feature-x":true}
FLAGS_OVERRIDE=

# ===== Misc =====
# Default partner commission % (0-100), si no está seteado por partner.
PARTNER_DEFAULT_COMMISSION_PCT=15
# Cooling-off period (días) para account deletion. GDPR recomienda 30.
PRIVACY_DELETION_COOLOFF_DAYS=30
