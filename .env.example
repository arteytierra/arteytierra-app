# Plantilla de variables de entorno del monorepo.
#
# Esta lista sale de barrer `process.env.*` en apps/web y apps/terreno: si una
# variable está acá es porque el código la lee, y si el código lee una que no
# está acá, es un bug de esta plantilla. NUNCA poner valores reales.
#
# Los valores de producción viven en Vercel (dos proyectos: arteytierra-app-web
# y terreno) — ver docs/DEPLOY_PRODUCTION.md.

# ===== Sitio =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ACEQUIA_APP_URL=https://app.acequia.app
# Sólo lo usa apps/terreno (InformeView), para saber si está corriendo en el host de la app.
NEXT_PUBLIC_ACEQUIA_APP_HOST=app.acequia.app
NEXT_PUBLIC_ACEQUIA_SITE_URL=https://acequia.app
# Desde apps/terreno, adónde volver al sitio principal.
NEXT_PUBLIC_WEB_URL=https://arteytierra.org
# Se muestra en /api/health para saber qué build está vivo. En Vercel conviene
# apuntarla a $VERCEL_GIT_COMMIT_SHA; sin esto el health responde "version":"dev".
NEXT_PUBLIC_APP_VERSION=
# Lo mismo para apps/terreno.
NEXT_PUBLIC_BUILD_ID=

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Stripe (USD / internacional) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Mercado Pago (ARS / LATAM) =====
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ===== PayPal (sólo suscripciones de acequia) =====
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' o 'live'.
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# ===== Cobros de acequia =====
# Interruptor general de los cobros de acequia. Falla cerrado: sin 'true' no cobra.
ACEQUIA_PAYMENTS_ENABLED=false
# CSV de emails que pueden pagar mientras ACEQUIA_PAYMENTS_ENABLED sigue apagado.
ACEQUIA_PAYMENTS_TEST_EMAILS=
# Mantener false hasta aprobar legales, sandbox y la migración de prueba.
ACEQUIA_TRIAL_ENABLED=false
# Tipo de cambio para mostrar precios en pesos.
ACEQUIA_ARS_PER_USD=
# Adónde llegan los avisos de alta/baja de suscripción.
ACEQUIA_AVISOS_EMAIL=

# ===== Webhooks de pago =====
# Falla cerrado: sin 'true', las rutas de webhook de Stripe/MP/PayPal no procesan nada.
PAYMENT_WEBHOOKS_ENABLED=false

# ===== Email =====
# La cadena es Resend -> Postmark -> noop. Se elige por la primera API key presente.
RESEND_API_KEY=
POSTMARK_API_KEY=
# Token que firma el webhook de eventos de Postmark (/api/webhooks/postmark).
POSTMARK_WEBHOOK_TOKEN=
EMAIL_FROM="Arte y Tierra <hola@arteytierra.org>"
EMAIL_REPLY_TO=hola@arteytierra.org

# ===== n8n =====
N8N_WEBHOOK_URL=
# Token que mandamos nosotros al llamar a n8n.
N8N_WEBHOOK_TOKEN=
# Token con el que n8n nos llama a nosotros (/api/n8n/*).
N8N_INTERNAL_TOKEN=

# ===== Meta: pixel, CAPI y Messenger/Instagram =====
META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Código de prueba del Events Manager; dejar vacío en producción.
META_CAPI_TEST_CODE=
# Firma de los webhooks de Messenger/Instagram (X-Hub-Signature-256).
META_APP_SECRET=
# Handshake de verificación del webhook de Meta.
META_VERIFY_TOKEN=
# Token de página para responder por Messenger/Instagram.
META_PAGE_ACCESS_TOKEN=

# ===== WhatsApp Cloud API =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ===== Chatbot (Claude) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Falla cerrado: el bot contesta SÓLO con 'true'.
BOT_ENABLED=false
# Adónde escala el bot una consulta de obra/diseño.
BOT_ESCALATION_EMAIL=

# ===== Analytics =====
# OJO: el código lee NEXT_PUBLIC_GA_MEASUREMENT_ID (formato G-XXXX), no NEXT_PUBLIC_GA_ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Rate de muestreo de Core Web Vitals (0 — 1). Recomendado 0.1 en producción.
RUM_SAMPLE_RATE=1
NEXT_PUBLIC_RUM_SAMPLE_RATE=1
# Recorrido mínimo del producto (apps/terreno). Mantener false hasta revisar privacidad.
NEXT_PUBLIC_PRODUCT_ANALYTICS_ENABLED=false
# Muestra dentro de la app el acceso directo al formulario del piloto (apps/terreno).
NEXT_PUBLIC_PILOT_MODE_ENABLED=false
# Token del webhook que avisa de postulaciones al piloto.
PILOT_NOTIFICATION_WEBHOOK_TOKEN=

# ===== Certificados de cursos =====
# Firma el código de verificación del certificado. Cambiarlo invalida los ya emitidos.
CERT_SIGNING_SECRET=

# ===== Videollamadas (Jitsi JaaS) =====
JITSI_APP_ID=
JITSI_DOMAIN=8x8.vc
JITSI_KEY_ID=
JITSI_PRIVATE_KEY=

# ===== Web Push (VAPID) =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@arteytierra.org

# ===== Cron =====
# Bearer que valida /api/cron/[job]. Lo usan cron.yml (GitHub Actions) y el cron de Vercel.
CRON_SECRET=

# ===== i18n =====
# CSV con locales habilitados además de 'es'. Vacío = sólo ES.
ENABLE_LOCALES=
