{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@arteytierra/config": ["../../packages/config/src/index.ts"],
      "@arteytierra/config/*": ["../../packages/config/src/*"],
      "@arteytierra/types": ["../../packages/types/src/index.ts"],
      "@arteytierra/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
